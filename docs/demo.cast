[18.34, "o", "\u001b[5;21H\u001b(B\u001b[0;2m\u001b[39;49m\u001b[37m\u001b[40monly with tag Environment=prod\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[K\r\n\n\n\n  \u001b(B\u001b[0;2m\u001b[39;49m\u001b[37m\u001b[40mJev choice probabilities · selection returns to your command line\n\n\u001b[3G\u001b(B\u001b[0;1m\u001b[39;49m\u001b[37m\u001b[40m› 1. [recipe] 100% List EC2 instances with tag Environment=prod in table format\n\u001b[3G\u001b(B\u001b[0;7m\u001b[39;49m\u001b[37m\u001b[40m   aws ec2 describe-instances --filters Name=tag:Environment,Values=prod --query \n\u001b[3G   'Reservations[].Instances[].{ID:InstanceId,State:State.Name,Type:InstanceType,Name:Tags[?Key==`Name`].Value|[0]}' --output \n\u001b[3G   table\u001b[24;3H\u001b(B\u001b[0;2m\u001b[39;49m\u001b[37m\u001b[40mUses the current AWS region/profile. 'All' means all pages in that region.\u001b[27;3H↑↓ choose · Enter insert · / follow-up · e edit request · Esc cancel\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
