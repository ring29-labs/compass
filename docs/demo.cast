[10.11, "o", "\u001b[5;3H\u001b(B\u001b[0;2m\u001b[39;49m\u001b[37m\u001b[40mPrevious request: list all instances in table format\n\u001b[3G\u001b(B\u001b[0;1m\u001b[39;49m\u001b[37m\u001b[40mCorrection or follow-up?\u001b[9;3H\u001b(B\u001b[0;2m\u001b[39;49m\u001b[37m\u001b[40mJev choice probabilities · selection returns to your command line\n\n\u001b[3G\u001b(B\u001b[0;1m\u001b[39;49m\u001b[37m\u001b[40m› 1. [recipe] 96% List all EC2 instances in table format with ID, Name, State and Type\n\u001b[3G\u001b(B\u001b[0;7m\u001b[39;49m\u001b[37m\u001b[40m   aws ec2 describe-instances --query \n\u001b[3G   'Reservations[].Instances[].{ID:InstanceId,State:State.Name,Type:InstanceType,Name:Tags[?Key==`Name`].Value|[0]}' --output \n\u001b[3G   table\n\u001b[5G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m2. [completion] 4% describe-instances\r\n  \u001b(B\u001b[0;2m\u001b[39;49m\u001b[37m\u001b[40m   aws ec2 describe-instances --output table\u001b[24;3HUses the current AWS region/profile. 'All' means all pages in that region.\u001b[27;3H↑↓ choose · Enter insert · / follow-up · e edit request · Esc cancel\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
